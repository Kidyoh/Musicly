   "i": 0,
   "text": "Meet Musicly.",
   "start": 0.45,
   "dur": 0.824,
   "file": "audio/lines/00.wav"
  },
  {
   "i": 1,
   "text": "Every song you love, in one calm player.",
   "start": 1.574,
   "dur": 2.043,
   "file": "audio/lines/01.wav"
  },
  {
   "i": 2,
   "text": "Run a Telegram channel? Add a bot, and every song you post plays in full, and saves to your phone.",
   "start": 4.368,
   "dur": 5.039,
   "file": "audio/lines/02.wav"
  },
  {
   "i": 3,
   "text": "Your own music.",
   "start": 10.156,
   "dur": 0.824,
   "file": "audio/lines/03.wav"
  },
  {
   "i": 4,
   "text": "Live radio from around the world.",
   "start": 11.261,
   "dur": 1.741,
   "file": "audio/lines/04.wav"
  },
  {
   "i": 5,
   "text": "And lyrics that sing along, in time.",
   "start": 13.282,
   "dur": 1.974,
   "file": "audio/lines/05.wav"
  },
  {
   "i": 6,
   "text": "Controls on your lock screen. Widgets on your home screen.",
   "start": 16.006,
   "dur": 2.798,
   "file": "audio/lines/06.wav"
  },
  {
   "i": 7,
   "text": "But here's the best part. Jam.",
   "start": 19.654,
   "dur": 1.625,
   "file": "audio/lines/07.wav"
  },
  {
   "i": 8,
   "text": "Start a Jam, and share the code.",
   "start": 21.829,
   "dur": 1.707,
   "file": "audio/lines/08.wav"
  },
  {
   "i": 9,
   "text": "Friends join from anywhere, and hear the same song, in sync, on their own phone.",
   "start": 23.836,
   "dur": 4.331,
   "file": "audio/lines/09.wav"
  },
  {
   "i": 10,
   "text": "Everyone can add songs. From your library, or straight from their own phone.",
   "start": 28.966,
   "dur": 3.901,
   "file": "audio/lines/10.wav"
  },
  {
   "i": 11,
   "text": "You stay in control. Friends can pause and skip only if you allow it.",
   "start": 33.667,
   "dur": 3.402,
   "file": "audio/lines/11.wav"
  },
  {
   "i": 12,
   "text": "Together in the same room? No internet needed.",
   "start": 37.869,
   "dur": 2.241,
   "file": "audio/lines/12.wav"
  },
  {
   "i": 13,
   "text": "Musicly. Your music, together.",
   "start": 40.96,
   "dur": 1.753,
   "file": "audio/lines/13.wav"
  },
  {
   "i": 14,
   "text": "Download it on GitHub.",
   "start": 43.063,
   "dur": 1.173,
   "file": "audio/lines/14.wav"
  }
